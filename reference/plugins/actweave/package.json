{
  "name": "@poiema/actweave",
  "version": "0.0.0",
  "description": "Author standard DSH Skills backed by existing typed tools.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "lib/index.d.ts.map",
    "cordis.patch.yml",
    "examples/skills/**/SKILL.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.host.json --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "acceptance:clean-profile": "node scripts/clean-profile.mjs",
    "acceptance:native-mcp": "node --import tsx scripts/native-mcp.mjs",
    "acceptance:native-mcp-negative": "ACTWEAVE_NATIVE_MCP_NEGATIVE=1 node --import tsx scripts/native-mcp.mjs",
    "acceptance:page-browser": "ACTWEAVE_PAGE_BROWSER=1 node --import tsx scripts/native-mcp.mjs",
    "build:rss-client": "npm run build --prefix ../actweave-rss-page",
    "security:audit": "node scripts/security-audit.mjs"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@types/node": "24.10.1",
    "js-yaml": "4.3.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
